# ============================================================================
# EnterpriseAI Auth Service — Environment variables template
# ============================================================================
# 1. Copy this file to `.env` (the real values file is git-ignored).
#       cp .env.example .env
# 2. Fill in real secrets.
#
# NOTE: never commit the real `.env`. It is excluded via `apps/auth/gitignore`
#       (pattern: `.env`).

# --- Application -----------------------------------------------------------
APP_NAME=EnterpriseAI Auth Service
ENV=development

# Print full config at startup for sanity checks (never enable in production).
SHOW_LOADED_ENV=false

# --- First admin (platform / vendor admin) ----------------------------------
# Created when the auth service starts, if no admin with this email exists yet.
# An existing admin is left as is (its password is never reset by a restart).
# Leave both empty to skip. Password: at least 8 characters. Use a real-looking
# domain: login rejects reserved ones like .local / .test.
ADMIN_EMAIL=admin@enterpriseai.io
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Admin

# --- First tenant (a company) and its tenant admin ---------------------------
# Created with a first workspace when the auth service starts, if no account
# with TENANT_ADMIN_EMAIL exists yet; left as is otherwise. Empty = skip.
TENANT_NAME=EnterpriseAI Demo
TENANT_ADMIN_EMAIL=tenantadmin@enterpriseai.io
TENANT_ADMIN_PASSWORD=
TENANT_ADMIN_FULL_NAME=Tenant Admin


# --- HTTP / CORS ------------------------------------------------------------
API_V1_PREFIX=/api/v1
# JSON array of allowed browser origins.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8001"]

# --- Database -----------------------------------------------------------
# PostgreSQL (production):
#   postgresql+asyncpg://auth:auth@localhost:5432/auth
# SQLite (local dev, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./auth.db
# Changing DATABASE_URL is all it takes to switch engines — the SAME Alembic
# migration chain builds the schema natively on whatever you point at.
# Tables/migrations are applied automatically at API startup.
# Echo all SQL statements (dev only).
DB_ECHO=false

# --- JWT (RS256 asymmetric signing) ----------------------------------------
# If both keys are left EMPTY, a fresh RSA-2048 keypair is generated and
# persisted under `apps/auth/.keys/` (git-ignored) on first startup.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=enterprise-ai-auth
JWT_AUDIENCE=enterprise-ai
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- SSO / OIDC (Google example) -------------------------------------------
SSO_PROVIDER=google
SSO_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SSO_CLIENT_SECRET=your-google-client-secret
SSO_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
SSO_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# LLM Gateway — Unified LLM Proxy
# ============================================================================

# --- Provider API Keys (set at least one) -----------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Provider Defaults -------------------------------------------------------
OPENAI_DEFAULT_MODEL=gpt-4.1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# --- Optional: custom base URLs (rarely needed) -----------------------------
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Azure OpenAI (the "azure" provider) -------------------------------------
# Same variables as AI_Marketplace. With a key + endpoint set, azure becomes the
# default provider unless LLM_GATEWAY_DEFAULT_PROVIDER says otherwise. Azure
# routes by deployment name: AZURE_OPENAI_DEPLOYMENT is used for every chat call
# (default gpt-4o-mini); AZURE_OPENAI_EMBEDDING_DEPLOYMENT, when set, also makes
# azure the embedding provider.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Optional: Azure behind the "openai" provider (older setup) --------------
# Set OPENAI_BASE_URL to your *.azure.com endpoint + OPENAI_API_VERSION to
# switch OPENAI_API_KEY/OPENAI_BASE_URL over to Azure OpenAI routing
# (auto-detected). Azure routes by deployment name, not model name, so tell
# it which deployment to use per model (optional — falls back to
# OPENAI_DEFAULT_MODEL / OPENAI_EMBEDDING_MODEL when unset, which only works
# if your deployment happens to share the model's name).
# OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Gateway Behaviour -------------------------------------------------------
# Default provider for text generation: azure | openai | groq | gemini
# (empty: azure when it's configured, else openai)
LLM_GATEWAY_DEFAULT_PROVIDER=azure
# Provider for embeddings (MCP catalog search): fastembed (default — local
# BAAI/bge-small-en-v1.5, no API key) | gemini | openai | azure. A hosted one
# without a key falls back to fastembed.
LLM_GATEWAY_EMBEDDING_PROVIDER=fastembed
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# Timeout per upstream call (seconds)
LLM_GATEWAY_TIMEOUT=60
# Retries before giving up on a single provider
LLM_GATEWAY_MAX_RETRIES=3
# Response caching (1 | true | yes to enable)
LLM_GATEWAY_ENABLE_CACHE=false
# Cache TTL in seconds
LLM_GATEWAY_CACHE_TTL=3600

# ============================================================================
# Backend Service — Vendor Resources
# ============================================================================
# AES-256-GCM key for encrypting vendor tool secrets (32-byte urlsafe-base64).
# Generate one with:
#   uv run python -c "from vendor_resources.core.vault import generate_key; print(generate_key())"
# If left EMPTY, a deterministic dev-only key is derived (NEVER use in production).
VENDOR_VAULT_KEY=
# ============================================================================
# Backend Service — Knowledge Bases (RAG)
# ============================================================================
# Chunk embeddings: fastembed (local ONNX, no API key, default) | gateway
# (the LLM gateway's LLM_GATEWAY_EMBEDDING_PROVIDER). Switching backends needs
# existing documents re-uploaded — retrieval ignores vectors from another model.
KNOWLEDGE_EMBEDDING_BACKEND=fastembed
# KNOWLEDGE_EMBEDDING_MODEL_FASTEMBED=BAAI/bge-small-en-v1.5
# KNOWLEDGE_EMBEDDING_MODEL_GATEWAY=
# RAG_TOP_K=8
# RAG_MAX_UPLOAD_BYTES=26214400
# RAG_RERANK_ENABLED=true
# Scanned PDFs / images need the Tesseract OCR binary (installed in the
# backend Docker image; locally: apt install tesseract-ocr).

# ============================================================================
# Backend Service — Builder tool runtime (running MCP tools as end users)
# ============================================================================
# TOOL_CALL_TIMEOUT_SECONDS=60
# TOOL_CALL_MAX_TIMEOUT_SECONDS=600
# TOOL_SESSION_CONNECT_TIMEOUT_SECONDS=120
# Pooled sessions (and their stdio processes) close after this long unused.
# TOOL_SESSION_IDLE_SECONDS=300
# TOOL_SESSION_MAX_OPEN=64
# TOOL_SESSION_MAX_PER_USER=8
# TOOL_RESULT_MAX_CHARS=100000
# Per-user HOME for stdio MCP servers (credential files live here, mode 0700).
# BUILDER_USER_HOME_ROOT=/tmp/enterpriseai-mcp-home

# ============================================================================
# Backend Service — Builder runs (agents / workflows)
# ============================================================================
# inline: the backend process runs the worker itself (local dev, `make dev`).
# redis:  runs are queued on Redis Streams and executed by `worker` containers
#         (`python -m builder.worker`); docker-compose sets this.
BUILDER_QUEUE_BACKEND=inline
# REDIS_URL=redis://localhost:6379/0
# WORKER_CONCURRENCY=4
# A worker renews its lease every RUN_HEARTBEAT_SECONDS; if it dies, another
# worker resumes the run from its last checkpoint after RUN_LEASE_SECONDS.
# RUN_LEASE_SECONDS=60
# RUN_HEARTBEAT_SECONDS=15
# RUN_REAPER_INTERVAL_SECONDS=30
# RUN_MAX_ATTEMPTS=5
