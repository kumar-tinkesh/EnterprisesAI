# ============================================================================
# EnterpriseAI Auth Service — Environment variables template
# ============================================================================
# 1. Copy this file to `.env` (the real values file is git-ignored).
#       cp .env.example .env
# 2. Fill in real secrets.
#
# NOTE: never commit the real `.env`. It is excluded via `apps/auth/gitignore`
#       (pattern: `.env`).

# --- Application -----------------------------------------------------------
APP_NAME=EnterpriseAI Auth Service
ENV=development
DEBUG=true

# Print full config at startup for sanity checks (never enable in production).
SHOW_LOADED_ENV=false

# --- HTTP / CORS ------------------------------------------------------------
API_V1_PREFIX=/api/v1
# JSON array of allowed browser origins.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8001"]

# --- Database -----------------------------------------------------------
# PostgreSQL (production):
#   postgresql+asyncpg://auth:auth@localhost:5432/auth
# SQLite (local dev, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./auth.db
# Changing DATABASE_URL is all it takes to switch engines — the SAME Alembic
# migration chain builds the schema natively on whatever you point at.
# Tables/migrations are applied automatically at API startup.
# Echo all SQL statements (dev only).
DB_ECHO=false

# --- JWT (RS256 asymmetric signing) ----------------------------------------
# If both keys are left EMPTY, a fresh RSA-2048 keypair is generated and
# persisted under `apps/auth/.keys/` (git-ignored) on first startup.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=enterprise-ai-auth
JWT_AUDIENCE=enterprise-ai
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- SSO / OIDC (Google example) -------------------------------------------
SSO_PROVIDER=google
SSO_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SSO_CLIENT_SECRET=your-google-client-secret
SSO_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
SSO_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Security / CSRF --------------------------------------------------------
# Change this in production.
CSRF_SECRET_KEY=change-me-in-production
CSRF_COOKIE_NAME=csrf_token
CSRF_COOKIE_AGE=10800

# ============================================================================
# LLM Gateway — Unified LLM Proxy
# ============================================================================

# --- Provider API Keys (set at least one) -----------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Provider Defaults -------------------------------------------------------
OPENAI_DEFAULT_MODEL=gpt-4.1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# --- Optional: custom base URLs (rarely needed) -----------------------------
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Gateway Behaviour -------------------------------------------------------
# Default provider for text generation: openai | groq | gemini
LLM_GATEWAY_DEFAULT_PROVIDER=openai
# Default provider for embeddings: gemini | openai
LLM_GATEWAY_EMBEDDING_PROVIDER=gemini
# Timeout per upstream call (seconds)
LLM_GATEWAY_TIMEOUT=60
# Retries before giving up on a single provider
LLM_GATEWAY_MAX_RETRIES=3
# Response caching (1 | true | yes to enable)
LLM_GATEWAY_ENABLE_CACHE=false
# Cache TTL in seconds
LLM_GATEWAY_CACHE_TTL=3600