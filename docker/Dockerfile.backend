# ---------------------------------------------------------------------------
# Backend Service Dockerfile
# Builds the EnterpriseAI backend service for MCP server management
# ---------------------------------------------------------------------------

# --- WhatsApp bridge builder ------------------------------------------------
# Vendored + patched fork of github.com/lharries/whatsapp-mcp's Go bridge —
# see apps/backend/vendor/services/whatsapp_bridge/vendor_src/README.md for
# why it's vendored (per-user port isolation) and patched (whatsmeow version
# bump — WhatsApp raises its minimum client version over time, so this stage
# may need bumping `go.mod`'s whatsmeow pin again in the future; the debian
# apt `golang-go` package is far too old for whatsmeow's requirement).
FROM golang:1.26-bookworm AS whatsapp_bridge_builder
WORKDIR /src
COPY apps/backend/vendor/services/whatsapp_bridge/vendor_src/bridge/ ./
RUN go build -o /out/whatsapp-bridge .

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    nodejs \
    npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=whatsapp_bridge_builder /out/whatsapp-bridge /app/bin/whatsapp-bridge

# Copy uv configuration and install dependencies
COPY pyproject.toml uv.lock ./
RUN pip install uv
RUN uv sync --frozen

# Copy source code
# CACHEBUST: pass --build-arg CACHEBUST=<anything-new> to force this layer
# (and everything after it) to redo when the build cache goes stale, without
# needing a full --no-cache rebuild (which reinstalls apt/uv from scratch).
# The RUN below must actually consume the arg, or it has no effect on the
# cache key and the stale COPY layer gets reused as-is.
ARG CACHEBUST=1
RUN echo "cachebust=$CACHEBUST"
COPY apps/ apps/
COPY alembic.ini ./

# Pre-download the hybrid-search reranker's ONNX model at build time (~80MB)
# so the first real query doesn't pay for a HuggingFace Hub download, and
# the container works without internet egress at runtime.
RUN uv run python -c "from fastembed.rerank.cross_encoder import TextCrossEncoder; TextCrossEncoder(model_name='Xenova/ms-marco-MiniLM-L-6-v2')"

# Entrypoint script (tracked in git; avoids relying on BuildKit heredoc parsing)
COPY docker/entrypoint.backend.sh entrypoint.sh
RUN sed -i 's/\r$//' entrypoint.sh && chmod +x entrypoint.sh

EXPOSE 8002

ENTRYPOINT ["./entrypoint.sh"]