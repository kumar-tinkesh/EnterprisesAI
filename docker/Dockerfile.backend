# ---------------------------------------------------------------------------
# Backend Service Dockerfile
# Builds the EnterpriseAI backend service for MCP server management
# ---------------------------------------------------------------------------

# --- Stage 1 (Parallel): WhatsApp bridge builder (Go) -----------------------
# Vendored + patched fork of github.com/lharries/whatsapp-mcp's Go bridge.
FROM golang:1.26-bookworm AS whatsapp_bridge_builder
WORKDIR /src
COPY apps/backend/vendor/services/whatsapp_bridge/vendor_src/bridge/go.mod \
     apps/backend/vendor/services/whatsapp_bridge/vendor_src/bridge/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY apps/backend/vendor/services/whatsapp_bridge/vendor_src/bridge/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -o /out/whatsapp-bridge .

# --- Stage 2 (Parallel): Python dependencies builder ------------------------
FROM python:3.12-slim AS python_builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Pre-download the hybrid-search reranker's ONNX model (~80MB) in this stage
# so it is CACHED once and never re-downloaded when application source code changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv run python -c "from fastembed.rerank.cross_encoder import TextCrossEncoder; TextCrossEncoder(model_name='Xenova/ms-marco-MiniLM-L-6-v2')"

# --- Stage 3: Runtime --------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install runtime system tools using BuildKit APT cache (without slow build-essential)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Copy WhatsApp bridge from Go builder
COPY --from=whatsapp_bridge_builder /out/whatsapp-bridge /app/bin/whatsapp-bridge

# Copy Python venv and cached FastEmbed model from Python builder
COPY --from=python_builder /app/.venv /app/.venv
COPY --from=python_builder /app/.cache /app/.cache

# Copy project files needed for uv and execution
COPY pyproject.toml uv.lock .python-version alembic.ini ./
COPY apps/ apps/

# Entrypoint script
COPY docker/entrypoint.backend.sh entrypoint.sh
RUN sed -i 's/\r$//' entrypoint.sh && chmod +x entrypoint.sh

EXPOSE 8002

ENTRYPOINT ["./entrypoint.sh"]