# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp bridge orchestrator — built from the repo root context
#   docker build -f docker/Dockerfile.whatsapp_orchestrator .
# The ONLY container in this stack that gets /var/run/docker.sock mounted —
# see apps/whatsapp_orchestrator/main.py for why that's scoped to this one
# small service instead of the backend.
# ─────────────────────────────────────────────────────────────────────────────
ARG PYTHON_IMAGE=python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
FROM ${PYTHON_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY apps/whatsapp_orchestrator/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/whatsapp_orchestrator/main.py .

EXPOSE 8090
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8090"]
