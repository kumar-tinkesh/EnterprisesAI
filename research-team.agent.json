            "language": "auto",
            "formats": [],
            "citations": "always"
          },
          "tools": {
            "max_calls": 8,
            "timeout_seconds": 30,
            "on_failure": "continue"
          },
          "approvals": {
            "read": false,
            "edit": true,
            "delete": true
          },
          "guardrails": {
            "injection": false,
            "tool_injection": false,
